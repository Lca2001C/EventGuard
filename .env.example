DATABASE_URL=postgresql://eventguard:eventguard@localhost:15432/eventguard?schema=public
# Optional. When set, email/WhatsApp notifications run through BullMQ workers.
# When empty, notifications are sent synchronously (dev friendly).
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Storage: leave STORAGE_PROVIDER empty for local disk fallback (served at /uploads).
# Use "r2" or "s3" with the credentials below for cloud object storage.
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public base URL for stored objects (CDN / bucket public URL).
STORAGE_PUBLIC_URL=

# Email: leave EMAIL_PROVIDER empty to log emails to the console (dev).
# Use "smtp" (with SMTP_* below) or "resend" (with EMAIL_API_KEY).
EMAIL_PROVIDER=
EMAIL_FROM=EventGuard <no-reply@eventguard.local>
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp: leave WHATSAPP_PROVIDER empty to log messages (dev).
# Use "meta" with WHATSAPP_TOKEN and WHATSAPP_PHONE_ID for the Cloud API.
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Two-factor authentication (TOTP) issuer label shown in authenticator apps.
TWO_FACTOR_ISSUER=EventGuard

NODE_ENV=development
