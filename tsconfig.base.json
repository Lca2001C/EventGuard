{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@eventguard/shared": ["packages/shared/src/index.ts"],
      "@eventguard/validations": ["packages/validations/src/index.ts"],
      "@eventguard/config": ["packages/config/src/index.ts"],
      "@eventguard/ui": ["packages/ui/src/index.ts"]
    }
  }
}
