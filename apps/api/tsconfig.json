{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@eventguard/shared": ["../../packages/shared/src/index.ts"],
      "@eventguard/validations": ["../../packages/validations/src/index.ts"],
      "@eventguard/config": ["../../packages/config/src/index.ts"]
    }
  },
  "include": ["src", "../../prisma/seed.ts", "test"]
}
